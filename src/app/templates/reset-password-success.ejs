<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Password Reset Successful</title>
</head>

<body style="margin:0; padding:0; background-color:#f4f7fb; font-family:Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f7fb; padding:40px 15px;">

        <tr>
            <td align="center">

                <!-- Main Card -->
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                    max-width:520px;
                    background-color:#ffffff;
                    border-radius:16px;
                    overflow:hidden;
                ">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="
                            padding:35px 30px;
                            background-color:#111827;
                        ">

                            <!-- Success Icon -->
                            <div style="
                            width:60px;
                            height:60px;
                            line-height:60px;
                            margin:0 auto 18px;
                            background-color:#22c55e;
                            border-radius:50%;
                            color:#ffffff;
                            font-size:30px;
                            font-weight:bold;
                        ">
                                ✓
                            </div>

                            <h1 style="
                            margin:0;
                            color:#ffffff;
                            font-size:24px;
                            font-weight:700;
                        ">
                                Password Reset Successful
                            </h1>

                            <p style="
                            margin:10px 0 0;
                            color:#cbd5e1;
                            font-size:14px;
                        ">
                                Your account password has been updated
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:35px 35px 30px;">

                            <p style="
                            margin:0 0 15px;
                            color:#374151;
                            font-size:16px;
                            line-height:1.6;
                        ">
                                Hello <strong>
                                    <%= name %>
                                </strong>,
                            </p>

                            <p style="
                            margin:0 0 18px;
                            color:#6b7280;
                            font-size:15px;
                            line-height:1.7;
                        ">
                                Your password has been changed successfully.
                                You can now log in to your
                                <strong style="color:#374151;">
                                    Raven
                                </strong>
                                account using your new password.
                            </p>

                            <!-- Success Message -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="
                                background-color:#f0fdf4;
                                border:1px solid #bbf7d0;
                                border-radius:12px;
                                margin:25px 0;
                            ">
                                <tr>
                                    <td style="padding:18px 20px;">

                                        <p style="
                                        margin:0;
                                        color:#166534;
                                        font-size:14px;
                                        line-height:1.6;
                                    ">
                                            ✓ &nbsp;
                                            Your password has been securely updated.
                                        </p>

                                    </td>
                                </tr>
                            </table>

                            <p style="
                            margin:0 0 18px;
                            color:#6b7280;
                            font-size:14px;
                            line-height:1.7;
                        ">
                                If you did not make this change, please contact
                                our support team immediately to secure your account.
                            </p>

                            <hr style="
                            border:0;
                            border-top:1px solid #e5e7eb;
                            margin:30px 0;
                        ">

                            <p style="
                            margin:0;
                            text-align:center;
                            color:#9ca3af;
                            font-size:12px;
                            line-height:1.6;
                        ">
                                For your security, never share your password
                                with anyone.
                            </p>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="
                            padding:20px;
                            background-color:#f9fafb;
                            border-top:1px solid #e5e7eb;
                        ">

                            <p style="
                            margin:0;
                            color:#9ca3af;
                            font-size:12px;
                        ">
                                &copy; <%= new Date().getFullYear() %>
                                    Raven. All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>


</body>

</html>