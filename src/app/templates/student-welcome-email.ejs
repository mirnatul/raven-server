<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
</head>

<body style="margin:0; padding:0; background:#f4f7fb; font-family:Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:40px 15px;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="max-width:600px; background:#ffffff; border-radius:18px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background:#4f46e5; padding:40px 30px;">
                            <div style="font-size:42px; margin-bottom:10px;">🎓</div>

                            <h1 style="margin:0; color:#ffffff; font-size:28px;">
                                Welcome to Pathshala!
                            </h1>

                            <p style="margin:10px 0 0; color:#e0e7ff; font-size:15px;">
                                We're excited to have you with us.
                            </p>
                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:40px 35px; color:#374151;">

                            <h2 style="margin:0 0 15px; color:#111827; font-size:22px;">
                                Your account is ready 🎉
                            </h2>

                            <p style="font-size:16px; line-height:1.7; margin:0 0 20px;">
                                Welcome to our platform! Your student account has been
                                successfully created and you're ready to get started.
                            </p>

                            <!-- Email Card -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background:#f5f7ff; border:1px solid #e0e7ff; border-radius:12px; margin:25px 0;">
                                <tr>
                                    <td style="padding:18px 20px;">
                                        <p
                                            style="margin:0 0 6px; font-size:12px; color:#6b7280; text-transform:uppercase; letter-spacing:1px;">
                                            Registered User
                                        </p>

                                        <p style="margin:0; font-size:16px; font-weight:bold; color:#4f46e5;">
                                            <%= name %>
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <p style="font-size:15px; line-height:1.7; color:#6b7280;">
                                You can now log in and explore everything available to you.
                                We’re looking forward to having you on board!
                            </p>

                            <!-- Button -->
                            <table cellpadding="0" cellspacing="0" border="0" style="margin:30px auto 10px;">
                                <tr>
                                    <td align="center" style="border-radius:10px; background:#4f46e5;">
                                        <a href="#"
                                            style="display:inline-block; padding:14px 30px; color:#ffffff; text-decoration:none; font-size:15px; font-weight:bold;">
                                            Get Started →
                                        </a>
                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background:#f9fafb; padding:25px; border-top:1px solid #f0f0f0;">

                            <p style="margin:0 0 8px; font-size:13px; color:#6b7280;">
                                Welcome to the community 💙
                            </p>

                            <p style="margin:0; font-size:12px; color:#9ca3af;">
                                This is an automated email. Please do not reply.
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>

    </table>

</body>

</html>