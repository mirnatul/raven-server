<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to Raven</title>
</head>

<body style="margin:0; padding:0; background:#f4f7f6; font-family:Arial, Helvetica, sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="padding:40px 15px; background:#f4f7f6;">
        <tr>
            <td align="center">

                <table width="100%" cellpadding="0" cellspacing="0" border="0"
                    style="max-width:600px; background:#ffffff; border-radius:18px; overflow:hidden;">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background:#101b18; padding:40px 30px;">

                            <div style="font-size:42px; margin-bottom:12px;">
                                🐦‍⬛
                            </div>

                            <h1 style="margin:0; color:#ffffff; font-size:30px; letter-spacing:1px;">
                                Welcome to Raven
                            </h1>

                            <p style="margin:12px 0 0; color:#a7c5b9; font-size:14px;">
                                See what's next. Build what matters.
                            </p>

                        </td>
                    </tr>

                    <!-- Content -->
                    <tr>
                        <td style="padding:40px 35px; color:#374151;">

                            <h2 style="margin:0 0 15px; color:#101b18; font-size:23px;">
                                Your journey starts here 🎉
                            </h2>

                            <p style="font-size:16px; line-height:1.7; margin:0 0 20px;">
                                Welcome to Raven! Your client account has been successfully
                                created. You're now ready to turn your ideas into meaningful
                                projects with our team.
                            </p>

                            <!-- User Card -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                style="background:#f0f7f3; border:1px solid #d5e8df; border-radius:12px; margin:25px 0;">

                                <tr>
                                    <td style="padding:18px 20px;">

                                        <p
                                            style="margin:0 0 6px; font-size:12px; color:#718078; text-transform:uppercase; letter-spacing:1px;">
                                            Registered Client
                                        </p>

                                        <p style="margin:0; font-size:17px; font-weight:bold; color:#007a55;">
                                            <%= name %>
                                        </p>

                                    </td>
                                </tr>

                            </table>

                            <p style="font-size:15px; line-height:1.7; color:#6b7280;">
                                Explore our services, share your requirements, and take
                                the first step toward building something remarkable.
                                We're excited to work with you.
                            </p>

                            <!-- Button -->
                            <table cellpadding="0" cellspacing="0" border="0" style="margin:30px auto 10px;">

                                <tr>
                                    <td align="center" style="border-radius:10px; background:#007a55;">

                                        <a href="#"
                                            style="display:inline-block; padding:14px 30px; color:#ffffff; text-decoration:none; font-size:15px; font-weight:bold;">
                                            Explore Raven →
                                        </a>

                                    </td>
                                </tr>

                            </table>

                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background:#f7faf8; padding:25px; border-top:1px solid #e5eee9;">

                            <p style="margin:0 0 8px; font-size:13px; color:#527064;">
                                Let's build something remarkable together.
                            </p>

                            <p style="margin:0; font-size:12px; color:#9aaa9f;">
                                This is an automated email. Please do not reply.
                            </p>

                            <p style="margin:15px 0 0; font-size:12px; color:#007a55; font-weight:bold;">
                                RAVEN
                            </p>

                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

</body>

</html>