model Project {
    id String @id @default(uuid())

    // Original request
    serviceRequestId String         @unique
    serviceRequest   ProjectRequest @relation(fields: [serviceRequestId], references: [id])

    // Client
    clientId String
    client   Client @relation(fields: [clientId], references: [id])

    // Project information
    title       String
    description String
    budget      Int
    startDate   DateTime?
    deadline    DateTime?

    // Project management
    projectManagerId String?
    projectManager   User?   @relation(fields: [projectManagerId], references: [id])

    status ProjectStatus @default(PLANNING)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    members               ProjectMember[]
    tasks                 Task[]
    developerAvailability DeveloperAvailability[]
}

enum ProjectStatus {
    PLANNING
    IN_PROGRESS
    CLIENT_REVIEW
    COMPLETED
    CANCELLED
    ARCHIVED
}
