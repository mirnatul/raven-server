model JobApplication {
    id String @id @default(uuid())

    // Job
    jobOpeningId String
    jobOpening   JobOpening @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)

    // only work if hired
    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

    // Applicant snapshot
    name          String
    email         String
    contactNumber String
    address       String

    // Documents
    resume          String
    resumePublicId  String
    additionalFiles Json?

    // Application
    coverLetter  String?
    portfolioUrl String?
    githubUrl    String?
    linkedinUrl  String?

    // Hiring information
    expectedSalary Decimal?  @db.Decimal(10, 2)
    availableFrom  DateTime?

    // Status
    status JobApplicationStatus @default(UNDER_REVIEW)

    // Hiring
    hiredAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([jobOpeningId])
    @@index([status])
    @@index([email])
    @@map("job_applications")
}

enum JobApplicationStatus {
    UNDER_REVIEW
    HIRED
}
